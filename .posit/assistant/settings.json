{
  "sandbox": {
    "enabled": false
  },
  "permission": {
    "edit": {
      "*.md": "allow",
      "*.R": "allow",
      "*.yml": "allow",
      "*.qmd": "allow",
      "*/DESCRIPTION": "allow",
      "*/.gitignore": "allow",
      "*/.Rbuildignore": "allow",
      "*.yaml": "allow"
    },
    "executeCode": {
      "*": "allow"
    },
    "bash": {
      "*": "allow",
      "cat *": "allow",
      "echo *": "allow",
      "git add *": "allow",
      "git status *": "allow",
      "git commit *": "allow",
      "git log *": "allow"
    },
    "webfetch": {
      "https://posit-dev.github.io/*": "allow",
      "https://raw.githubusercontent.com/*": "allow"
    }
  }
}
